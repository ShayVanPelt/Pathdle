# =============================================================================
# Pathdle — environment variables (copy to .env files; never commit secrets)
# =============================================================================
# Usage:
#   apps/web/.env.local          ← Next.js (copy WEB section)
#   apps/api / Cloud Run         ← set API + shared vars in the host env
#   apps/generator / Cloud Run Job ← set GENERATOR + shared vars
#
# ASP.NET reads env vars with __ for nesting, e.g. ConnectionStrings__Postgres
# =============================================================================

# -----------------------------------------------------------------------------
# WEB (Next.js / Vercel) — apps/web/.env.local
# -----------------------------------------------------------------------------

# Play API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5294

# Supabase (browser) — optional until auth / leaderboards
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API (ASP.NET Core / Cloud Run) — Pathdle.Api
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
# Local HTTP profile uses http://localhost:5294
ASPNETCORE_URLS=http://localhost:5294

# Comma-separated browser origins allowed to call the API
Cors__AllowedOrigins=http://localhost:3000

# Storage: InMemory (default MVP) | Postgres (when wired)
Pathdle__Storage=InMemory

# PostgreSQL / Supabase connection (play DB — puzzles, games, scores)
# Supabase: Project Settings → Database → Connection string (URI)
# Prefer the "Transaction" pooler URI for serverless/Cloud Run if available
ConnectionStrings__Postgres=

# Optional: direct Supabase service role for server-side admin (API/generator only — NEVER expose to the browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# GENERATOR (Cloud Run Job) — Pathdle.Generator
# -----------------------------------------------------------------------------

# Same Postgres connection as the API (publishes daily_puzzles)
# ConnectionStrings__Postgres=

# Neo4j AuraDB (corpus + puzzle generation ONLY — not used during gameplay)
Neo4j__Uri=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
Neo4j__Username=neo4j
Neo4j__Password=
Neo4j__Database=neo4j

# Which Wikipedia corpus build to use when generating
Pathdle__CorpusVersion=hand-authored-mvp

# Shared secret / OIDC audience if the job is triggered via HTTP later (optional)
# Pathdle__GeneratorAuthToken=

# -----------------------------------------------------------------------------
# GOOGLE CLOUD (deploy / scheduler — set in GCP, not usually in local .env)
# -----------------------------------------------------------------------------

# GOOGLE_CLOUD_PROJECT=
# CLOUD_RUN_SERVICE=pathdle-api
# CLOUD_RUN_JOB=pathdle-generator
# # Cloud Scheduler cron for daily generation (example: 02:00 UTC)
# PATHDLE_GENERATE_CRON=0 2 * * *

# -----------------------------------------------------------------------------
# VERCEL (set in Vercel project settings)
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_API_BASE_URL=https://your-api-xxxxx.run.app
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# - Puzzle day is UTC.
# - Clients send identity as header: X-Player-Key (anonymous UUID in localStorage).
# - Do not put Neo4j credentials in the Next.js / Vercel env — frontend never talks to Neo4j.
# - Do not put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* vars.
