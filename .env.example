# =============================================================================
# Pathdle — single monorepo .env (copy from .env.example → .env)
# Never commit .env
# =============================================================================
# Loaded by:
#   - Pathdle.Api (DotNetEnv) from repo root
#   - Next.js via next.config (NEXT_PUBLIC_* only needed by web)
# =============================================================================

# -----------------------------------------------------------------------------
# WEB
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5294
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5294
Cors__AllowedOrigins=http://localhost:3000
Pathdle__Storage=Postgres

# Local Docker: docker compose up -d
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=pathdle;Username=pathdle;Password=pathdle

# Supabase — replace YOUR_PASSWORD (percent-encode special chars if using a URI)
ConnectionStrings__Postgres=Host=db.izsgumsvymrypcflnuzn.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# GENERATOR (Neo4j corpus + daily publish)
# -----------------------------------------------------------------------------
# Local Docker: docker compose up -d neo4j
Neo4j__Uri=bolt://localhost:7687
Neo4j__Username=neo4j
Neo4j__Password=pathdle-neo4j
Neo4j__Database=neo4j
Pathdle__CorpusVersion=wiki-crawl-mvp-v1

# Aura later:
# Neo4j__Uri=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
# Neo4j__Username=neo4j
# Neo4j__Password=

# -----------------------------------------------------------------------------
# CLOUD RUN (production) — set these on the service / Job, not in git
# -----------------------------------------------------------------------------
# Pathdle__Storage=Postgres
# ConnectionStrings__Postgres=...   # prefer Secret Manager (pathdle-pg)
# Cors__AllowedOrigins=https://your-app.vercel.app
# See docs/deploy-cloud-run.md

