# Copy values into your shell, user-secrets, or Cloud Run env.
# Full reference: ../../../.env.example
#
# dotnet user-secrets init --project apps/api/Pathdle.Api
# dotnet user-secrets set "ConnectionStrings:Postgres" "postgresql://..." --project apps/api/Pathdle.Api

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5294

Cors__AllowedOrigins=http://localhost:3000
Pathdle__Storage=InMemory

# When switching off in-memory:
# Pathdle__Storage=Postgres
# ConnectionStrings__Postgres=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
